{
  "name": "@ermis-network/ermis-chat-sdk",
  "version": "2.1.0-external.1",
  "description": "Ermis Chat SDK",
  "author": "Ermis",
  "homepage": "https://ermis.network/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ermisnetwork/ermis-chat-monorepo.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/index.mjs": "./dist/index.browser.mjs",
    "./dist/index.cjs": "./dist/index.browser.cjs",
    "./dist/encryption/index.mjs": "./dist/encryption/index.browser.mjs",
    "./dist/encryption/index.cjs": "./dist/encryption/index.browser.cjs"
  },
  "react-native": {
    "./dist/index.mjs": "./dist/index.browser.mjs",
    "./dist/index.cjs": "./dist/index.browser.cjs",
    "./dist/encryption/index.mjs": "./dist/encryption/index.browser.mjs",
    "./dist/encryption/index.cjs": "./dist/encryption/index.browser.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./encryption": {
      "types": "./dist/encryption/index.d.ts",
      "import": "./dist/encryption/index.mjs",
      "require": "./dist/encryption/index.cjs"
    },
    "./public/*": "./public/*"
  },
  "bin": {
    "ermis-init-call": "bin/init-call.js"
  },
  "jsdelivr": "./dist/index.browser.full-bundle.min.js",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "chat",
    "messaging",
    "conversation",
    "react",
    "ermis",
    "ermis.network"
  ],
  "files": [
    "/dist",
    "README.md",
    "readme.md",
    "license",
    "/bin",
    "/public"
  ],
  "dependencies": {
    "@noble/hashes": "1.4.0",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/ws": "^7.4.0",
    "axios": "^1.6.0",
    "event-source-polyfill": "^1.0.31",
    "form-data": "^4.0.0",
    "isomorphic-ws": "^4.0.1",
    "minisearch": "^7.2.0",
    "ws": "^7.4.4"
  },
  "devDependencies": {
    "@types/node": "^16.11.11",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch",
    "types": "tsc --noEmit",
    "test:media": "node --test test/e2ee_media_streaming.test.cjs",
    "test:attachments": "node --test test/e2ee_attachments.test.cjs",
    "test:external": "node --test test/external_contract.test.cjs",
    "test:repair": "node --test test/external_contract.test.cjs"
  }
}
