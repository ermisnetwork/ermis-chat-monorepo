# Internal services. Deploy Firebase handlers on the auth service before updating clients.
VITE_API_URL=https://chat.example.com
VITE_USS_API_URL=https://auth.example.com
VITE_API_KEY=your-ermis-application-key
VITE_CHAT_PROJECT_ID=your-ermis-project-id
VITE_END_USER_API_MODE=legacy

# Copy PUBLIC Web app config from Firebase Console, not Android/iOS application IDs.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
# The deployed Web hostname must be in Firebase Authentication Authorized domains.
# Firebase backend settings.firebase_auth_project_id must match this Firebase project.
